      "slug": "icml",
      "name": "ICML",
      "discipline": "人工智能",
      "query": "ICML",
      "exclude": ["workshop", "under review", "submitted", "submission", "submit to", "in submission", "about to commit"]
    },
    {
      "slug": "iclr",
      "name": "ICLR",
